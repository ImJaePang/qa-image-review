# 운영(VPS)용 설정 예시: 복사해서 .env.production 으로 만들고 값을 채운다 (.env.production 은 git에 올라가지 않는다).
#   cp .env.production.example .env.production
# 실행: docker compose --env-file .env.production -f docker-compose.yml -f docker-compose.prod.yml --profile app up -d --build
# 비밀번호·키는 길고 무작위로: 예) openssl rand -base64 36

# 접속 주소 (이 도메인의 DNS A 레코드가 서버 IP를 가리켜야 인증서가 발급된다)
DOMAIN=qa.example.com

# DB
POSTGRES_USER=qa
POSTGRES_PASSWORD=
POSTGRES_DB=qa_review

# 로그인 서명 키 (16자 이상, 길고 무작위로)
JWT_SECRET=

# 관리자 초기 계정: 첫 시작 때 시드의 데모 계정(비밀번호 1234)이 정리되고 이 값으로 관리자가 만들어진다. 없거나 12자 미만이면 서버가 시작되지 않는다.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# 데모 이미지는 만들지 않는다 (공개 서버에 보여 줄 데이터는 업로드로 넣는다)
DEMO_DATA_COUNT=0

# 메일 (임시 비밀번호 안내). 안 쓰면 off
MAIL_MODE=off
# MAIL_FROM=QA 검수 시스템 <no-reply@example.com>
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

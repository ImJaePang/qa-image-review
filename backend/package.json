{
  "name": "qa-review-backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=../.env --watch src/server.mjs",
    "start": "node --env-file=../.env src/server.mjs",
    "test": "node --env-file=../.env --test --test-concurrency=1 \"test/**/*.test.mjs\"",
    "generate-mock": "node scripts/generate-mock.mjs",
    "make-derivatives": "node --env-file=../.env scripts/make-derivatives.mjs",
    "worker": "node --env-file=../.env src/worker.mjs",
    "migrate": "node --env-file=../.env scripts/migrate.mjs",
    "load-mock": "node --env-file=../.env scripts/load-results.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/jwt": "^10.2.6",
    "fastify": "^5.12.7",
    "pg": "^8.23.1",
    "sharp": "^0.35.5"
  }
}

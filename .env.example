# 복사해서 .env 로 사용: cp .env.example .env  (.env 는 git에 올리지 않는다)
POSTGRES_USER=qa
POSTGRES_PASSWORD=change-me
POSTGRES_DB=qa_review
POSTGRES_PORT=5432

# 백엔드 (JWT_SECRET은 길고 무작위인 값으로)
API_PORT=3000
JWT_SECRET=change-me-to-a-long-random-string

# 메일 (임시 비밀번호 안내). 기본 off = 발송 안 함(관리자 화면에 임시 비밀번호를 보여 줌)
#   log  = 개발용: 메일 내용을 서버 로그에 출력 (운영에서는 사용 불가)
#   smtp = 실제 발송 (SMTP_HOST 필요). 비밀번호는 .env에만 두고 커밋하지 않는다
# MAIL_MODE=off
# MAIL_FROM=QA 검수 시스템 <no-reply@example.com>
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false   # 465 포트면 true
# SMTP_USER=
# SMTP_PASS=

# 전체 실행·배포 (docker compose --profile app up -d --build, 사용법은 docs/deploy.md)
# APP_PORT=8080          # 브라우저로 여는 포트
# DEMO_DATA_COUNT=300    # 처음 한 번 만들어 적재할 목 이미지 수 (0이면 빈 상태로 시작)
# COOKIE_SECURE=false    # HTTPS 없이 로컬에서 켤 때 false. 실제 도메인(HTTPS)에 올릴 때는 true
# TRUST_PROXY=false      # 리버스 프록시(nginx·호스팅 서비스) 뒤에서만 true (로그인 잠금이 접속 주소별로 정확해짐)

# 실제 모델(PatchCore) 사용 시: MODEL_ADAPTER=patchcore (기본 mock). 설정 방법은 python/README.md
# MODEL_ADAPTER=patchcore
# PATCHCORE_MODEL_DIR=   # 비우면 python/artifacts/patchcore
# PYTHON_BIN=            # 비우면 python/.venv 의 python
